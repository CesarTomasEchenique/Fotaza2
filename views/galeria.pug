doctype html
html(lang="es")
  head
    title Mi Perfil - FOTAZA 2
    link(rel="stylesheet", href="/stileGaleria.css") 
  body
    header.header
      .logo FOTAZA2
      .llevaraizquierda
      a(href="/fotazahome")
        button.btn-login Ir al Inicio

          
      
        //Contenedor del Feed de fotos abajo
    .feed-container

      if imagenes.length === 0
        p No hay publicaciones para mostrar.

      else
        each imagen in imagenes

          h3= imagen.title

          img(src=imagen.src width="300")

          p= imagen.description