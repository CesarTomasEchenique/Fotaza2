include mixin/alert
doctype html
html(lang="es")
  head
    title Iniciar Sesión - FOTAZA 2
    
  body
    header.header
      .logo FOTAZA2
      link(rel="stylesheet", href="/stileIniciarSesion.css")
      .llevaraizquierda
      a(href='/registro')
        button.btn-registro ir a Registrarse
    main.todolodemas 
      
        
        h1 Iniciar Sesión
        //- Si el controlador manda un error, se muestra acá
        if error
          p.error-message(style="color: red; margin-bottom: 15px;") #{error}
        +alert(alert)
        form(action="/login" method="POST" class="login-form")
          .paracss
            label(for="email") email usuario
            input(type="email" id="email" name="email" placeholder="admin@admin.com" required, value=formValues ? formValues.email : '')
          
          .paracss
            label(for="password") contraseña
            input(type="password" id="password" name="password" placeholder="Ingresa tu contraseña" required, value=formValues ? formValues.password : '')
          
          .paracss
            button(type="submit" class="btn-submit") Entrar
        
        a(href="/fotazahome" class="back-link") Volver al inicio