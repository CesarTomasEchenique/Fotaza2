doctype html
html(lang="es")
  head
    title Mi Perfil - FOTAZA 2
    link(rel="stylesheet", href="/stile.css") 
  body
    header.header
      .logo FOTAZA2
      .llevaraizquierda
      a(href="/fotazahome")
        button.btn-login Ir al Inicio

    main.container
      h1 ¡Bienvenido a tu perfil, #{usuario.firstName}!

            
      create-post
        h2 Publicar una nueva foto      
            
      .form-publicar


        form(action="/publicar", method="POST", enctype="multipart/form-data")
          .paracss
            label(for= "titulo") titulo de la foto 
            input(type="text", id="titulo", name="titulo", placeholder="Escribe un titulo", required)
          .paracss
            input(type="hidden", name="usuarioId", value=usuario.id)
            
          .paracss
            label(for="file-upload" class="custom-file-upload") 
            input(id="file-upload", type="file", name="foto", accept="image/*", required)
          .paracss
            label(for= "descripcion") descripción de la foto 
            input(type="text", id="descripcion", name="descripcion", placeholder="Escribe una descripción")
          .paracss
            label(for ="copyright") con copyright 
            select(id="copyright", name="copyright")
              option(value="true") Sí
              option(value="false") No

          .paracss
          button(type="submit" class="btn-publicar") Publicar
      .paracss
      a(href="/galeria")
        button Ver mi Galeria

        script.
          const inputFoto = document.getElementById('foto');
          const imagenBase64 = document.getElementById('imagenBase64');

          inputFoto.addEventListener('change', function(){

              const archivo = this.files[0];

              if(!archivo) return;

              const reader = new FileReader();

              reader.onload = function(e){
                  imagenBase64.value = e.target.result;
              };

              reader.readAsDataURL(archivo);
          });