include mixin/alert
doctype html
html(lang="es")
  head
    title Registrarse - FOTAZA 2
    
  body
    header.header
      .logo FOTAZA2
      link(rel="stylesheet", href="/stileRegistro.css")
      .llevaraizquierda
      a(href='/login')
        button.btn-registro ir a Iniciar Sesion
    main.todolodemas 
      
      
        
        h1 Registrarse en Fotaza 
        
        +alert(alert)
        form(action="/registro" method="POST" class="login-form")
          .paracss
            label(for="firstName") nombre
            input(type="text" id="firstName" name="firstName" placeholder="Ingresa tu nombre", value=formValues? formValues.firstName : '')
          
          .paracss 
            label(for="lastName") apellido
            input(type="text" id="lastName" name="lastName" placeholder="Ingresa tu apellido", value=formValues ? formValues.lastName : '')

          .paracss
            label(for="password") contraseña
            input(type="password" id="password" name="password" placeholder="Ingresa tu contraseña", value=formValues ? formValues.password : '')

          .paracss
            label(for="email") email
            input(type="email" id="email" name="email" placeholder="Ingresa tu email", value=formValues ? formValues.email : '')

          .paracss
            label(for="fechaNacimiento") fecha de nacimiento
            input(type="date" id="fechaNacimiento" name="cumpleanos" value=formValues ? formValues.cumpleanos : '')

          .paracss
            label(for="telefono") teléfono
            input(type="tel" id="telefono" name="phone" placeholder="Ingresa tu teléfono", value=formValues ? formValues.phone : '')

          .paracss
            button(type="submit" class="btn-submit") Registrarse
        
        a(href="/fotazahome" class="back-link") Volver al inicio